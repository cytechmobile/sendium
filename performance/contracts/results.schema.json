{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sendium performance results v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provenance", "configuration", "validity", "overall", "cohortIntervals", "eventIntervals", "resources", "drain", "measurementMetadata", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provenance": {
      "type": "object",
      "required": ["branch", "applicationCommit", "harnessRevision", "workflowRunUrl", "runIdentity", "artifacts"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "applicationCommit": { "$ref": "#/$defs/commit" },
        "harnessRevision": { "$ref": "#/$defs/commit" },
        "workflowRunUrl": { "type": ["string", "null"] },
        "runIdentity": { "type": "string", "minLength": 1 },
        "artifacts": { "type": "array", "items": { "type": "object", "required": ["name", "sha256"], "properties": { "name": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } }
      }
    },
    "configuration": {
      "type": "object",
      "required": ["workload", "application", "infrastructure"],
      "properties": {
        "workload": { "$ref": "run-config.schema.json" },
        "application": {
          "type": "object", "required": ["jvmArguments", "connections", "dlrStorage"],
          "properties": {
            "runtime": { "enum": ["jvm", "native"] },
            "jvmArguments": { "type": "array", "items": { "type": "string" } },
            "nativeArguments": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^-Xm[sx][1-9][0-9]*[mg]$" } },
            "nativeBuild": {
              "type": "object", "additionalProperties": false,
              "required": ["schemaVersion", "architecture", "builderImage", "compilerVersion", "buildArguments"],
              "properties": {
                "schemaVersion": { "const": 1 }, "architecture": { "enum": ["arm64", "x86_64"] },
                "builderImage": { "type": "string", "pattern": "^quay\\.io/quarkus/ubi9-quarkus-mandrel-builder-image@sha256:[a-f0-9]{64}$" },
                "compilerVersion": { "type": "string", "minLength": 1, "maxLength": 8192 },
                "buildArguments": { "const": ["-march=compatibility"] }
              }
            },
            "connections": { "type": "object" }, "dlrStorage": { "enum": ["postgresql", "disabled"] }
          },
          "allOf": [{ "if": { "required": ["runtime"], "properties": { "runtime": { "const": "native" } } },
                      "then": { "required": ["nativeArguments"], "properties": { "jvmArguments": { "maxItems": 0 } } } }]
        },
        "infrastructure": { "type": "object", "required": ["preset", "region", "sendium", "harness", "database"], "properties": { "preset": { "type": "string" }, "region": { "type": "string" }, "sendium": { "type": "object" }, "harness": { "type": "object" }, "database": { "type": "object" } } }
      }
    },
    "validity": { "type": "object", "required": ["status", "reasons"], "properties": { "status": { "enum": ["valid", "inconclusive", "failed"] }, "reasons": { "type": "array", "items": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 } } } } } },
    "overall": { "$ref": "#/$defs/measurements" },
    "cohortIntervals": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/measurements" }, { "type": "object", "required": ["startOffsetSeconds", "endOffsetSeconds"], "properties": { "startOffsetSeconds": { "$ref": "#/$defs/nonnegative" }, "endOffsetSeconds": { "$ref": "#/$defs/nonnegative" } } }] } },
    "eventIntervals": { "type": "array", "items": { "type": "object", "required": ["phase", "startOffsetSeconds", "durationSeconds", "providerResponses", "receiptsForwarded"], "properties": { "phase": { "enum": ["measurement", "drain"] }, "startOffsetSeconds": { "$ref": "#/$defs/nonnegative" }, "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }, "providerArrivals": { "$ref": "#/$defs/count" }, "providerResponses": { "$ref": "#/$defs/count" }, "receiptsGenerated": { "$ref": "#/$defs/count" }, "receiptsForwarded": { "$ref": "#/$defs/count" }, "outstanding": { "$ref": "#/$defs/backlog" }, "rates": { "$ref": "#/$defs/outputRates" } } } },
    "resources": { "type": "object", "required": ["sendium", "harness", "cpuCredits"], "properties": { "sendium": { "type": "array", "items": { "$ref": "#/$defs/resourceSample" } }, "harness": { "type": "array", "items": { "$ref": "#/$defs/resourceSample" } }, "cpuCredits": { "type": "array", "items": { "$ref": "#/$defs/creditState" } } } },
    "drain": { "type": "object", "required": ["durationSeconds", "timeoutReached", "unfinishedAccepted", "pendingAdmission"], "properties": { "durationSeconds": { "$ref": "#/$defs/nonnegative" }, "timeoutReached": { "type": "boolean" }, "unfinishedAccepted": { "$ref": "#/$defs/count" }, "pendingAdmission": { "$ref": "#/$defs/count" } } },
    "measurementMetadata": { "type": "object", "required": ["histogramAlgorithm", "histogramPrecision", "histogramOverflowCount", "duplicateDetectionHorizonSeconds", "limitations"], "properties": { "histogramAlgorithm": { "type": "string" }, "histogramPrecision": { "type": "object" }, "histogramOverflowCount": { "$ref": "#/$defs/count" }, "duplicateDetectionHorizonSeconds": { "$ref": "#/$defs/nonnegative" }, "inputTiming": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/inputTiming" }] }, "generatorPhases": { "type": "array", "items": { "type": "object", "properties": { "pacingMode": { "type": "string" }, "delayedByAtLeastOnePeriod": { "$ref": "#/$defs/count" }, "submissionLateness": { "$ref": "#/$defs/distribution" } } } }, "limitations": { "type": "array", "items": { "type": "string" } } } },
    "diagnostics": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "inputTiming": {
      "type": "object",
      "required": ["dispatchBoundary", "dispatchesDuringMeasurement", "dispatchesDuringDrain", "submissionToDispatch", "seconds"],
      "properties": {
        "dispatchBoundary": { "type": "string", "minLength": 1 },
        "dispatchesDuringMeasurement": { "$ref": "#/$defs/count" },
        "dispatchesDuringDrain": { "$ref": "#/$defs/count" },
        "submissionToDispatch": { "$ref": "#/$defs/distribution" },
        "seconds": { "type": "array", "items": { "type": "object", "required": ["startOffsetSeconds", "submissions", "dispatchStarts"], "properties": {
          "startOffsetSeconds": { "$ref": "#/$defs/count" }, "submissions": { "$ref": "#/$defs/count" }, "dispatchStarts": { "$ref": "#/$defs/count" }
        } } }
      }
    },
    "creditSample": { "type": "object", "required": ["timestamp"], "properties": { "timestamp": { "type": "string", "format": "date-time" }, "balanceAverage": { "$ref": "#/$defs/nullableNonnegative" }, "usageSum": { "$ref": "#/$defs/nullableNonnegative" }, "surplusBalanceAverage": { "$ref": "#/$defs/nullableNonnegative" }, "surplusChargedSum": { "$ref": "#/$defs/nullableNonnegative" } } },
    "creditState": { "type": "object", "required": ["instanceId", "mode", "samples"], "properties": { "source": { "enum": ["sendium", "harness"] }, "instanceId": { "type": "string" }, "instanceType": { "type": "string" }, "burstable": { "type": ["boolean", "null"] }, "mode": { "enum": ["standard", "unlimited", "not-applicable", "unknown"] }, "periodSeconds": { "type": "integer", "minimum": 1 }, "windowStart": { "type": "string", "format": "date-time" }, "windowEnd": { "type": "string", "format": "date-time" }, "samples": { "type": "array", "items": { "$ref": "#/$defs/creditSample" } }, "collectionIssues": { "type": "array", "items": { "type": "string" } } } },
    "backlog": { "type": "object", "required": ["pendingAdmission", "acceptedAwaitingProvider", "acceptedAwaitingReceipt"], "additionalProperties": { "$ref": "#/$defs/count" } },
    "outputRates": { "type": "object", "required": ["providerArrivalsPerSecond", "providerResponsesPerSecond", "receiptsForwardedPerSecond"], "additionalProperties": { "$ref": "#/$defs/nonnegative" } },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "count": { "type": "integer", "minimum": 0 },
    "nonnegative": { "type": "number", "minimum": 0 },
    "nullableNonnegative": { "type": ["number", "null"], "minimum": 0 },
    "distribution": { "type": "object", "required": ["count", "p50Millis", "p95Millis", "p99Millis", "minMillis", "maxMillis"], "properties": { "count": { "$ref": "#/$defs/count" }, "p50Millis": { "$ref": "#/$defs/nullableNonnegative" }, "p95Millis": { "$ref": "#/$defs/nullableNonnegative" }, "p99Millis": { "$ref": "#/$defs/nullableNonnegative" }, "minMillis": { "$ref": "#/$defs/nullableNonnegative" }, "maxMillis": { "$ref": "#/$defs/nullableNonnegative" } } },
    "measurements": {
      "type": "object",
      "required": ["durationSeconds", "counts", "rates", "latencies"],
      "properties": {
        "durationSeconds": { "$ref": "#/$defs/nonnegative" },
        "counts": { "type": "object", "required": ["scheduled", "attempted", "missed", "accepted", "rejected", "failed", "timedOut", "pendingAdmission", "providerArrivals", "providerResponses", "acceptedProviderCompleted", "acceptedAwaitingProvider", "receiptsGenerated", "receiptsForwarded", "acceptedReceiptForwarded", "acceptedAwaitingReceipt", "duplicateProviderRequests", "duplicateReceipts", "providerObservedWithoutAcceptance", "peakOutstanding", "peakTracked"], "additionalProperties": { "$ref": "#/$defs/count" } },
        "rates": { "type": "object", "required": ["requestedInputPerSecond", "attemptedInputPerSecond", "providerArrivalsPerSecond", "providerResponsesPerSecond", "receiptsForwardedPerSecond"], "additionalProperties": { "$ref": "#/$defs/nullableNonnegative" } },
        "latencies": { "type": "object", "required": ["acknowledgement", "submissionToProvider", "providerResponseCompletion", "receiptForwarding", "simulatorReceiptDelay"], "additionalProperties": { "$ref": "#/$defs/distribution" } }
      }
    },
    "resourceSample": { "type": "object", "required": ["timestamp", "cpuPercent", "rssBytes", "hostMemoryUsedBytes"], "properties": { "timestamp": { "type": "string", "format": "date-time" }, "intervalStartTimestamp": { "type": ["string", "null"], "format": "date-time" }, "intervalSeconds": { "$ref": "#/$defs/nullableNonnegative" }, "cpuPercent": { "$ref": "#/$defs/nullableNonnegative" }, "hostCpuPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }, "rssBytes": { "type": ["integer", "null"], "minimum": 0 }, "hostMemoryUsedBytes": { "type": ["integer", "null"], "minimum": 0 }, "hostMemoryTotalBytes": { "type": ["integer", "null"], "minimum": 0 }, "cpuCount": { "type": ["integer", "null"], "minimum": 1 }, "pid": { "type": ["integer", "null"], "minimum": 1 }, "processStartTicks": { "type": ["integer", "null"], "minimum": 0 } } }
  }
}
