{
  "schemaVersion": 1,
  "id": "aws-private-jvm-v1",
  "aws": {
    "regionEnvironmentVariable": "AWS_REGION",
    "githubEnvironment": "sendium-performance",
    "runStackPrefix": "sendium-perf-run-",
    "runIdentityFormat": "gh-{runId}-{runAttempt}",
    "availabilityZoneSelection": "first-common-offered-zone-and-second-available",
    "ec2Placement": "first-zone",
    "supportedArchitectures": ["x86_64", "arm64"],
    "burstableCreditMode": "standard",
    "instanceDefaults": {
      "sendium": "t4g.small",
      "harness": "t4g.small"
    },
    "minimumMemoryMiB": {"sendium": 2048, "harness": 2048}
  },
  "network": {
    "ownership": "per-run",
    "vpcCidr": "10.70.0.0/24",
    "privateSubnetCidrs": ["10.70.0.0/26", "10.70.0.64/26"],
    "publicIps": false,
    "internetGateway": false,
    "natGateway": false,
    "dnsSupport": true,
    "dnsHostnames": true,
    "interfaceEndpoints": ["ssm", "ssmmessages", "secretsmanager"],
    "gatewayEndpoints": ["s3"],
    "endpointPlacement": "first-zone",
    "privateDns": true,
    "securityGroupModel": "role-to-role"
  },
  "runtime": {
    "os": "amazon-linux-2023",
    "amiParameters": {
      "x86_64": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64",
      "arm64": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64"
    },
    "amiIds": {"x86_64": null, "arm64": null},
    "java": {
      "distribution": "Eclipse Temurin",
      "featureVersion": 25,
      "release": null,
      "imageType": "jre",
      "jvmImplementation": "hotspot",
      "archiveArchitectures": {"x86_64": "x64", "arm64": "aarch64"},
      "artifactResolution": "resolve-and-checksum-before-provisioning",
      "sendiumArguments": ["-Xms512m", "-Xmx512m", "-XX:+UseG1GC"],
      "harnessArguments": ["-Xms512m", "-Xmx512m", "-XX:+UseG1GC"]
    },
    "requiredTools": ["python3", "aws", "tar", "gzip"],
    "clockSynchronization": "amazon-time-sync-service",
    "rootVolume": {"type": "gp3", "sizeGiB": null, "sizeResolution": "ami-root-device-minimum", "encrypted": true, "deleteOnTermination": true},
    "installRoot": "/opt/sendium-benchmark",
    "runRoot": "/var/lib/sendium-benchmark",
    "metadataTokens": "required",
    "metadataHopLimit": 1
  },
  "database": {
    "engine": "postgres",
    "port": 5432,
    "majorVersion": "17",
    "engineVersion": null,
    "minorVersionResolution": "latest-available-in-major-before-provisioning",
    "instanceType": "db.t4g.small",
    "storageType": "gp3",
    "allocatedStorageGiB": 20,
    "maximumAllocatedStorageGiB": 0,
    "autoMinorVersionUpgrade": false,
    "allowMajorVersionUpgrade": false,
    "multiAz": false,
    "placement": "first-zone",
    "publiclyAccessible": false,
    "storageEncrypted": true,
    "backupRetentionDays": 0,
    "deletionProtection": false,
    "deletionPolicy": "Delete",
    "updateReplacePolicy": "Delete",
    "finalSnapshot": false,
    "databaseName": "sendium_benchmark",
    "username": "sendium_perf",
    "credentials": {"source": "per-run-secrets-manager-secret", "passwordLength": 32, "excludePunctuation": true},
    "sslMode": "verify-full",
    "forceSsl": true,
    "caBundlePath": "/opt/sendium-benchmark/rds-ca/global-bundle.pem",
    "poolMinSize": 0,
    "poolMaxSize": 10,
    "acquisitionTimeoutMillis": 5000,
    "claimDurationSeconds": 300
  },
  "workload": {
    "schemaVersion": 1,
    "ingressMode": "http",
    "offeredMessagesPerSecond": 100,
    "workerTps": 100,
    "warmupSeconds": 120,
    "measurementSeconds": 600,
    "drainTimeoutSeconds": 120,
    "dlrEnabled": true,
    "providerResponseDelayMillis": 5,
    "providerDlrDelayMillis": 1000,
    "admissionTimeoutMillis": 10000,
    "maxOutstandingRequests": 1000,
    "maxTrackedMessages": 100000
  },
  "deployment": {
    "httpPort": 8080,
    "smppPort": 27777,
    "providerPort": 27779,
    "callbackPort": 8081,
    "ingressWindow": 1000,
    "outgoingWindow": 1000,
    "providerWindow": 1000,
    "providerMaxPending": 100000,
    "connectTimeoutMillis": 5000,
    "outgoingRequestTimeoutMillis": 30000,
    "providerIoTimeoutMillis": 10000,
    "outgoingWorkerThreads": 1,
    "callbackThreads": 4,
    "callbackQueueCapacity": 100
  },
  "measurement": {
    "readinessTimeoutSeconds": 180,
    "retentionSeconds": 300,
    "intervalBudget": 256,
    "sampleIntervalSeconds": 1,
    "sampleBudgetPerSource": 8192,
    "cloudWatchCreditPeriodSeconds": 300
  },
  "bounds": {
    "maximumWarmupSeconds": 600,
    "maximumMeasurementSeconds": 3600,
    "maximumDrainSeconds": 600,
    "maximumOfferedMessagesPerSecond": 1000000000,
    "maximumProviderResponseDelayMillis": 10000,
    "maximumProviderDlrDelayMillis": 60000
  },
  "lifecycle": {
    "provisioningTimeoutMinutes": 45,
    "executionJobTimeoutMinutes": 180,
    "retrievalTimeoutMinutes": 15,
    "cleanupTimeoutMinutes": 30,
    "resourceTtlMinutes": 240,
    "expiryMechanism": "eventbridge-scheduled-lambda",
    "expiryScheduleMinutes": 15,
    "temporaryArtifactExpirationDays": 1,
    "githubArtifactRetentionDays": 30
  }
}
