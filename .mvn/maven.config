# Avoid optional discovery retries against inherited JBoss repositories during outages.
# Artifact downloads remain enabled; Central and other repositories retain prefix discovery.
-Daether.remoteRepositoryFilter.prefixes.resolvePrefixFiles.jboss-public-repository-group=false
-Daether.remoteRepositoryFilter.prefixes.resolvePrefixFiles.jboss-public-repository=false
-Daether.remoteRepositoryFilter.prefixes.resolvePrefixFiles.jbossThirdParty=false
-Daether.remoteRepositoryFilter.prefixes.resolvePrefixFiles.jboss-deprecated-repository=false
