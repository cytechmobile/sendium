{
  "uid": "sendium-application-health",
  "title": "Sendium - Application Health",
  "description": "Process/runtime and HTTP/database-pool diagnostics for one selected Sendium instance. Scrape success is not application readiness. JVM panels can be absent in native images. Optional or inactive signals may show No data, not zero. Uses existing metrics only; no new probes or alerts.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "timezone": "browser",
  "tags": ["sendium", "health"],
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [
    {"name": "datasource", "label": "Prometheus", "type": "datasource", "query": "prometheus", "current": {"text": "Prometheus", "value": "sendium-prometheus"}},
    {"name": "job", "label": "Job", "type": "query", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "query": "label_values(up, job)", "refresh": 1, "sort": 1, "multi": false, "includeAll": false, "current": {"text": "sendium", "value": "sendium"}},
    {"name": "instance", "label": "Instance", "type": "query", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "query": "label_values(up{job=\"$job\"}, instance)", "refresh": 1, "sort": 1, "multi": false, "includeAll": false}
  ]},
  "panels": [
    {"id": 1, "type": "row", "title": "Current process overview - scrape availability is not readiness", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}, "collapsed": false, "panels": []},
    {"id": 2, "type": "stat", "title": "Metrics endpoint reachable - current", "description": "Prometheus up: 1 means last scrape succeeded, 0 means scrape failed. Does not measure Quarkus readiness, provider binds or SMS delivery. A target removed from discovery may have no series.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 0, "y": 1, "w": 6, "h": 4},
      "targets": [{"refId": "A", "expr": "up{job=\"$job\",instance=\"$instance\"}", "instant": true, "range": false}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "noValue": "No data", "mappings": [{"type": "value", "options": {"0": {"text": "Unreachable", "color": "red"}, "1": {"text": "Reachable", "color": "green"}}}]}, "overrides": []}, "options": {"graphMode": "none", "colorMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 3, "type": "stat", "title": "Application uptime - current", "description": "Process uptime for the selected instance at the selected range end. Resets on application restart; not deployment availability history.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 6, "y": 1, "w": 6, "h": 4},
      "targets": [{"refId": "A", "expr": "process_uptime_seconds{job=\"$job\",instance=\"$instance\"}", "instant": true, "range": false}],
      "fieldConfig": {"defaults": {"unit": "s", "noValue": "No data"}, "overrides": []}, "options": {"graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 4, "type": "stat", "title": "Process CPU - current", "description": "Recent CPU usage fraction reported by the runtime, displayed as percent. Optional runtime signal; not a count of cores used.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 12, "y": 1, "w": 6, "h": 4},
      "targets": [{"refId": "A", "expr": "process_cpu_usage{job=\"$job\",instance=\"$instance\"} >= 0", "instant": true, "range": false}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "noValue": "No data"}, "overrides": []}, "options": {"graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 5, "type": "stat", "title": "JVM heap used - current", "description": "Heap memory used, not whole-process resident memory. JVM-specific; may be absent in native images.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 18, "y": 1, "w": 6, "h": 4},
      "targets": [{"refId": "A", "expr": "sum(jvm_memory_used_bytes{job=\"$job\",instance=\"$instance\",area=\"heap\"})", "instant": true, "range": false}],
      "fieldConfig": {"defaults": {"unit": "bytes", "noValue": "No data"}, "overrides": []}, "options": {"graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 6, "type": "row", "title": "Runtime - JVM-specific signals may be unavailable for native images", "gridPos": {"x": 0, "y": 5, "w": 24, "h": 1}, "collapsed": false, "panels": []},
    {"id": 7, "type": "timeseries", "title": "CPU usage", "description": "Recent process and host/system CPU fractions. Negative unsupported values are omitted. Runtime/container interpretation depends on platform.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "process_cpu_usage{job=\"$job\",instance=\"$instance\"} >= 0", "legendFormat": "Process"}, {"refId": "B", "expr": "system_cpu_usage{job=\"$job\",instance=\"$instance\"} >= 0", "legendFormat": "System"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 8, "type": "timeseries", "title": "JVM heap memory", "description": "Heap used, committed and reported positive maximums. Omits undefined negative maximums. Heap is not total process RSS.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "sum(jvm_memory_used_bytes{job=\"$job\",instance=\"$instance\",area=\"heap\"})", "legendFormat": "Used"}, {"refId": "B", "expr": "sum(jvm_memory_committed_bytes{job=\"$job\",instance=\"$instance\",area=\"heap\"})", "legendFormat": "Committed"}, {"refId": "C", "expr": "sum(jvm_memory_max_bytes{job=\"$job\",instance=\"$instance\",area=\"heap\"} > 0)", "legendFormat": "Reported max"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 9, "type": "timeseries", "title": "JVM non-heap memory used", "description": "Metaspace, code heaps and other non-heap pools. JVM-only; no native/RSS fallback is fabricated.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 0, "y": 14, "w": 8, "h": 8},
      "targets": [{"refId": "A", "expr": "jvm_memory_used_bytes{job=\"$job\",instance=\"$instance\",area=\"nonheap\"}", "legendFormat": "{{id}}"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}},
    {"id": 10, "type": "timeseries", "title": "JVM live threads by state", "description": "Runtime thread counts by state. Not an exact count of virtual threads; semantics depend on JVM instrumentation.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 8, "y": 14, "w": 8, "h": 8},
      "targets": [{"refId": "A", "expr": "sum by (state) (jvm_threads_states_threads{job=\"$job\",instance=\"$instance\"})", "legendFormat": "{{state}}"}],
      "fieldConfig": {"defaults": {"unit": "locale", "decimals": 0, "min": 0}, "overrides": []}},
    {"id": 11, "type": "timeseries", "title": "Garbage-collection pauses / second", "description": "Observed GC pause events. Idle or unsupported GC instrumentation may have no series.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 16, "y": 14, "w": 8, "h": 8},
      "targets": [{"refId": "A", "expr": "sum by (gc) (rate(jvm_gc_pause_seconds_count{job=\"$job\",instance=\"$instance\"}[$__rate_interval]))", "legendFormat": "{{gc}}"}],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []}},
    {"id": 12, "type": "timeseries", "title": "Mean GC pause duration", "description": "Mean pause duration during the rate window, not p95/p99. No result when no GC pauses complete; idle is not zero latency.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "sum by (gc) (rate(jvm_gc_pause_seconds_sum{job=\"$job\",instance=\"$instance\"}[$__rate_interval])) / (sum by (gc) (rate(jvm_gc_pause_seconds_count{job=\"$job\",instance=\"$instance\"}[$__rate_interval])) > 0)", "legendFormat": "{{gc}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}},
    {"id": 13, "type": "timeseries", "title": "JVM memory allocation rate", "description": "GC-derived allocation estimate, not total process memory growth. Requires supported GC instrumentation.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "rate(jvm_gc_memory_allocated_bytes_total{job=\"$job\",instance=\"$instance\"}[$__rate_interval])", "legendFormat": "Allocation"}],
      "fieldConfig": {"defaults": {"unit": "Bps", "min": 0}, "overrides": []}},
    {"id": 14, "type": "row", "title": "HTTP - framework request metrics, not SMS delivery results", "gridPos": {"x": 0, "y": 30, "w": 24, "h": 1}, "collapsed": false, "panels": []},
    {"id": 15, "type": "timeseries", "title": "HTTP requests / second by status", "description": "All instrumented HTTP request completions, not just SMS submissions. Quarkus endpoint inclusion/exclusion follows runtime configuration.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 0, "y": 31, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"$job\",instance=\"$instance\"}[$__rate_interval]))", "legendFormat": "HTTP {{status}}"}],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []}},
    {"id": 16, "type": "timeseries", "title": "HTTP 5xx error fraction", "description": "Fraction of completed instrumented HTTP requests returning 5xx. No traffic means no ratio. A 4xx SMS rejection is not a server 5xx error.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 12, "y": 31, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "(sum(rate(http_server_requests_seconds_count{job=\"$job\",instance=\"$instance\",status=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(http_server_requests_seconds_count{job=\"$job\",instance=\"$instance\"}[$__rate_interval])))) / (sum(rate(http_server_requests_seconds_count{job=\"$job\",instance=\"$instance\"}[$__rate_interval])) > 0)", "legendFormat": "5xx fraction"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "noValue": "No data"}, "overrides": []}},
    {"id": 17, "type": "timeseries", "title": "Mean HTTP latency by route", "description": "Request completion mean, not p95/p99. No result for idle routes. Route labels come from framework templates, not request payloads.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 0, "y": 39, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "sum by (method,uri) (rate(http_server_requests_seconds_sum{job=\"$job\",instance=\"$instance\"}[$__rate_interval])) / (sum by (method,uri) (rate(http_server_requests_seconds_count{job=\"$job\",instance=\"$instance\"}[$__rate_interval])) > 0)", "legendFormat": "{{method}} {{uri}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}},
    {"id": 18, "type": "timeseries", "title": "Active HTTP connections and requests", "description": "Open connections and currently active requests are different measures, not additive. Availability depends on runtime instrumentation.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 12, "y": 39, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "http_server_active_connections{job=\"$job\",instance=\"$instance\"}", "legendFormat": "Open connections"}, {"refId": "B", "expr": "http_server_active_requests{job=\"$job\",instance=\"$instance\"}", "legendFormat": "Active requests"}],
      "fieldConfig": {"defaults": {"unit": "locale", "decimals": 0, "min": 0}, "overrides": []}},
    {"id": 19, "type": "row", "title": "Database pool and DLR storage operations - not database server monitoring", "gridPos": {"x": 0, "y": 47, "w": 24, "h": 1}, "collapsed": false, "panels": []},
    {"id": 20, "type": "timeseries", "title": "Database pool connections", "description": "Agroal active (in use) and available (idle) connections by datasource. Not a database readiness check or configured maximum capacity. DLR disabled may omit its datasource.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 0, "y": 48, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "agroal_active_count{job=\"$job\",instance=\"$instance\"}", "legendFormat": "{{datasource}} / active"}, {"refId": "B", "expr": "agroal_available_count{job=\"$job\",instance=\"$instance\"}", "legendFormat": "{{datasource}} / available"}],
      "fieldConfig": {"defaults": {"unit": "locale", "decimals": 0, "min": 0}, "overrides": []}},
    {"id": 21, "type": "timeseries", "title": "Threads awaiting database connections", "description": "Approximate number blocked acquiring a pool connection. Sustained growth warrants investigation; no arbitrary capacity threshold is assumed.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 12, "y": 48, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "agroal_awaiting_count{job=\"$job\",instance=\"$instance\"}", "legendFormat": "{{datasource}}"}],
      "fieldConfig": {"defaults": {"unit": "locale", "decimals": 0, "min": 0}, "overrides": []}},
    {"id": 22, "type": "timeseries", "title": "Mean database connection acquisition wait", "description": "Agroal's own average blocking-time gauge in milliseconds. This is not a Prometheus rate-window mean or query execution latency.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 0, "y": 56, "w": 8, "h": 8},
      "targets": [{"refId": "A", "expr": "agroal_blocking_time_average_milliseconds{job=\"$job\",instance=\"$instance\"}", "legendFormat": "{{datasource}}"}],
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0}, "overrides": []}},
    {"id": 23, "type": "timeseries", "title": "Invalid connections and detected leaks / second", "description": "Rates of Agroal diagnostic events. A single connection can be reported as leaking more than once; these are not unique failed SMS counts.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 8, "y": 56, "w": 8, "h": 8},
      "targets": [{"refId": "A", "expr": "rate(agroal_invalid_count_total{job=\"$job\",instance=\"$instance\"}[$__rate_interval])", "legendFormat": "{{datasource}} / invalid"}, {"refId": "B", "expr": "rate(agroal_leak_detection_count_total{job=\"$job\",instance=\"$instance\"}[$__rate_interval])", "legendFormat": "{{datasource}} / leak detections"}],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []}},
    {"id": 24, "type": "timeseries", "title": "DLR storage operations / second", "description": "Storage-operation completions by operation/outcome, not SMS counts. Background polling can produce operations while SMS traffic is idle.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 16, "y": 56, "w": 8, "h": 8},
      "targets": [{"refId": "A", "expr": "sum by (operation,outcome) (rate(sendium_dlr_storage_operation_seconds_count{job=\"$job\",instance=\"$instance\"}[$__rate_interval]))", "legendFormat": "{{operation}} / {{outcome}}"}],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []}},
    {"id": 25, "type": "timeseries", "title": "Mean DLR storage operation duration", "description": "Mean measured duration by operation/backend. Not database server latency or p95/p99. No result when no operations complete in the window.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 0, "y": 64, "w": 24, "h": 8},
      "targets": [{"refId": "A", "expr": "sum by (backend,operation) (rate(sendium_dlr_storage_operation_seconds_sum{job=\"$job\",instance=\"$instance\"}[$__rate_interval])) / (sum by (backend,operation) (rate(sendium_dlr_storage_operation_seconds_count{job=\"$job\",instance=\"$instance\"}[$__rate_interval])) > 0)", "legendFormat": "{{backend}} / {{operation}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}}
  ]
}
